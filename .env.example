# =============================================================================
# Nebula Mod 构建与发布 - 环境变量配置示例
# =============================================================================
# 使用说明:
# 1. 复制此文件为 .env
# 2. 填入你的真实 token
# 3. 运行 ./build_and_release.sh 即可自动加载
#
# 依赖要求:
# - Java 21+
# - Git
# - jq (用于构建合法的 JSON 数据)
#
#   Ubuntu/Debian: sudo apt install jq
#   Fedora/RHEL: sudo dnf install jq
#   Arch Linux: sudo pacman -S jq
#   macOS: brew install jq
#
# 安全提示:
# - .env 文件已在 .gitignore 中，不会被提交到 Git
# - 请妥善保管你的 token，不要分享给他人
# =============================================================================

# -----------------------------------------------------------------------------
# GitHub Token (必需 - 如果要上传到 GitHub Releases)
# -----------------------------------------------------------------------------
# 获取方法:
# 1. 访问 https://github.com/settings/tokens/new
# 2. 选择 "Classic" token 类型
# 3. Note 填写 "Nebula Build Script"
# 4. 勾选权限：repo (Full control of private repositories)
#    - 如果是公开仓库，只需勾选 public_repo 即可
# 5. 点击 "Generate token"
# 6. 复制生成的 token (以 ghp_ 开头)
# 7. 粘贴到下方
GITHUB_TOKEN=ghp_your_github_token_here

# -----------------------------------------------------------------------------
# GitHub 仓库信息 (必需 - 如果要上传到 GitHub Releases)
# -----------------------------------------------------------------------------
# 格式：用户名/仓库名
# 例如：atemukesu/nebula
GITHUB_REPOSITORY=your_username/your_repository

# -----------------------------------------------------------------------------
# Modrinth Token (必需 - 如果要上传到 Modrinth)
# -----------------------------------------------------------------------------
# 获取方法:
# 1. 访问 https://modrinth.com/settings/account
# 2. 向下滚动到 "Access tokens" 部分
# 3. 点击 "Create new token"
# 4. Name 填写 "Nebula Build Script"
# 5. Permissions 保持默认 (CREATE_VERSION, WRITE_PROJECT)
# 6. 点击 "Create token"
# 7. 复制生成的 token (一串随机字符)
# 8. 粘贴到下方
MODRINTH_TOKEN=your_modrinth_token_here

# -----------------------------------------------------------------------------
# 可选配置
# -----------------------------------------------------------------------------
# 是否启用详细日志 (true/false)
VERBOSE=false

# 是否跳过测试 (true/false)
SKIP_TESTS=true
